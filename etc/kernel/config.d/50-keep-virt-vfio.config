# 50-keep-virt-vfio.config
# keep these through drift.

# passthrough needs these
CONFIG_IOMMU_SUPPORT=y
CONFIG_AMD_IOMMU=y
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VFIO_IOMMU_TYPE1=m
CONFIG_VFIO_VIRQFD=y
CONFIG_VFIO_NOIOMMU=y

# runs the vms
CONFIG_KVM=m
CONFIG_KVM_AMD=m
CONFIG_KVM_GUEST=y
CONFIG_HYPERVISOR_GUEST=y

# vm and vpn networking
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_TUN=m

# guest devices
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_FS=m
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m

# how qemu shares folders
CONFIG_NET_9P=m
CONFIG_NET_9P_VIRTIO=m
CONFIG_9P_FS=m
CONFIG_9P_FSCACHE=y

# vm addressing
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_VXLAN=m
CONFIG_IP_VS=m
