# 51-keep-printers.config
# used every day.

# printers and dev boards
CONFIG_USB_PRINTER=m
CONFIG_USB_SERIAL=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_PL2303=m

# programmers need ppdev
CONFIG_PARPORT=m
CONFIG_PARPORT_PC=m
CONFIG_PARPORT_SERIAL=m
CONFIG_PRINTER=m
CONFIG_PPDEV=m

# serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIO=y
