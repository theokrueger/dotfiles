[terminal]
shell = "/bin/bash"
osc52 = "OnlyCopy"

[general]
live_config_reload = false
ipc_socket = false

[env]
TERM = "alacritty"
COLORTERM = "truecolor"

[window]
decorations = "None"
opacity = 1
dynamic_padding = false

[scrolling]
history = 15000
multiplier = 3

[font]
size = 12

[colors]
cursor = { text = "{{- .colours.bg }}", cursor = "{{- .colours.fg }}" }
selection = { text = "{{- .colours.bg }}", background = "{{- .colours.fg }}" }

[colors.primary]
foreground = "{{- .colours.text }}"
background = "{{- .colours.bg }}"
dim_foreground = "{{- .colours.text_unfocused }}"
bright_foreground = "{{- .colours.text_focused }}"

[bell]
animation = "EaseOutQuad"
duration = 13
color = "{{- .colours.fg }}"

[keyboard]
bindings = [
  { key = "C", mods = "Control|Shift", action = "Copy" },
  { key = "V", mods = "Control|Shift", action = "Paste" },
]
