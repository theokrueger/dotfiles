# chezmoi.yaml
# this file was generated by chezmoi

# host-specific values come from .chezmoidata.yaml; a host only overrides what
# it needs, everything else falls back to hosts.default.
{{- $hosts := .hosts | default dict }}
{{- $dev := merge (dict) (index $hosts .chezmoi.hostname | default dict) ($hosts.default | default dict) }}

{{- $windowManager := "" }}
{{- if eq .chezmoi.os "darwin" }}
  {{- $windowManager = "macos" }}
{{- else if eq .chezmoi.os "linux" }}
  {{- $windowManager = "sway" }}
{{- else if eq .chezmoi.os "windows" }}
  {{- $windowManager = "windows" }}
{{- end }}

# unknown hosts get their chassis guessed instead of configured
{{- $chassisType := $dev.chassis }}
{{- if not $chassisType }}
  {{- if eq .chezmoi.os "darwin" }}
    {{- if contains "MacBook" (output "sysctl" "-n" "hw.model") }}
      {{- $chassisType = "laptop" }}
    {{- else }}
      {{- $chassisType = "desktop" }}
    {{- end }}
  {{- else if eq .chezmoi.os "windows" }}
    {{- $chassisType = (output "powershell.exe" "-NoProfile" "-NonInteractive" "-Command" "if ((Get-CimInstance -Class Win32_Battery | Measure-Object).Count -gt 0) { Write-Output 'laptop' } else { Write-Output 'desktop' }") | trim }}
  {{- else if stat "/usr/bin/hostnamectl" }}
    {{- $chassisType = (output "hostnamectl" "--json=short" | mustFromJson).Chassis | lower }}
  {{- else if stat "/sys/class/power_supply/BAT0/present" }}
    {{- $chassisType = "laptop" }}
  {{- else }}
    {{- $chassisType = "desktop" }}
  {{- end }}
{{- end }}

{{- $fgColour := "#ff66cc" }}
{{- $bgColour := "#222222" }}
{{- $fgLightColour := "#ff00ff" }}
{{- $fgDarkColour := "#d1c7cb" }}

# directory of the dotfiles repo
sourceDir: "{{ if .chezmoi.workingTree }}{{ .chezmoi.workingTree }}{{ else }}{{ .chezmoi.sourceDir | dir }}{{ end }}"
edit.command: emacs -nw
encryption: "gpg"
# every managed target is private: 0600 files / 0700 directories
umask: 0o077
gpg:
  symmetric: true

data:
  music_directory: ~/backups/mosic
  bar_height: 20
  font:
    size: 10
    family: monospace
  colours:
    bg: "{{ $bgColour }}"
    fg: "{{ $fgColour }}"
    fg_light: "{{ $fgLightColour }}"
    fg_dark: "{{ $fgDarkColour }}"
    text: "#eee8d5"
    text_unfocused: "#93a1a1"
    text_focused: "#333333"
    border: "#657b83"
    highlight: "#7c81d4"

  # automatically set vars
  window_manager: {{ $windowManager }}
  chassis: {{ $chassisType }}
  primary_monitor_width: {{ $dev.primary_monitor_width }}
  primary_monitor_height: {{ $dev.primary_monitor_height }}
  keyboard_layout: {{ $dev.keyboard_layout }}

  lockscreen: ~/.local/share/lockscreens/{{- $dev.lockscreen }}
  static_background: ~/.local/share/wallpapers/{{- $dev.static_background }}
  animated_background:
    enabled: {{ $dev.animated_background.enabled }}
    folder: {{ if $dev.animated_background.folder }}~/.local/share/wallpapers/{{ $dev.animated_background.folder }}/{{ else }}""{{ end }}
    delay: {{ $dev.animated_background.delay }}
    overlay: {{ if $dev.animated_background.overlay }}"~/.local/share/wallpapers/{{ $dev.animated_background.overlay }}"{{ else }}""{{ end }}
