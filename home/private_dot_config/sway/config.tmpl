# root sway config
# Read `man 5 sway` for a complete reference.
include ./environment
include ./displays
include ./input
include ./keybinds
include ./style
include ./bar
include ./rules

# startup apps
exec mako
exec pipewire
exec pipewire-pulse
exec wireplumber
exec otd
exec mpd --no-daemon

exec /usr/libexec/polkit-gnome-authentication-agent-1
exec ~/.config/sway/scripts/sway-autotiler --limit 4 --splitratio 1.61
exec --no-startup-id dbus-update-activation-environment --all
exec_always ~/.config/sway/scripts/window-title-as-workspace.sh
#exec swayidle -w timeout 480 '~/.config/sway/scripts/lock.sh' timeout 600 'swaymsg "output * dpms off"' tmimeout 600 'loginctl suspend' resume 'swaymsg "output * dpms on"' before-sleep '~/.config/sway/scripts/lock.sh'
exec swayidle -w timeout 480 '~/.config/sway/scripts/lock.sh'
