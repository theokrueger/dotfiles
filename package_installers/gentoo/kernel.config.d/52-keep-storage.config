# 52-keep-storage.config
# disks and media

# controllers
CONFIG_BLK_DEV_NVME=m
CONFIG_ATA=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_BLK_DEV_LOOP=m

# root disk is luks
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=m

# main formats
CONFIG_BTRFS_FS=m
CONFIG_EXT4_FS=m
CONFIG_XFS_FS=m

# fat32 and friends
CONFIG_VFAT_FS=m
CONFIG_FAT_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_F2FS_FS=m

# flatpak and containers
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m
CONFIG_FUSE_FS=m

# cds and dvds
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m

# network shares
CONFIG_NFS_FS=m
CONFIG_NFSD=m
CONFIG_CIFS=m
CONFIG_SMB_SERVER=m
