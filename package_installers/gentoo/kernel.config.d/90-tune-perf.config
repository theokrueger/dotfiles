# 90-tune-perf.config
# speed over hardening

# build for this cpu
CONFIG_X86_NATIVE_CPU=y

# no alloc zeroing
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set

# not a debugging kernel
# CONFIG_KFENCE is not set

# idle dynticks only
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set

# better idle state choice
CONFIG_CPU_IDLE_GOV_TEO=y

# faster swap out
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y

# faster boot
CONFIG_KERNEL_ZSTD=y

# 16 threads here, not 8192
# CONFIG_MAXSMP is not set
CONFIG_NR_CPUS=256

# merge slab caches
CONFIG_SLAB_MERGE_DEFAULT=y

# snappier than 300
CONFIG_HZ_1000=y
